{
  "expo": {
    "name": "VestibularScreening",
    "slug": "VestibularScreening",
    "scheme": "vestibularscreening",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép VestibularScreening dùng camera để xem trước và quay video thử.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      "expo-sharing",
      ["expo-image-picker", { "photosPermission": "Cho phép chọn ảnh logo cơ sở để đưa vào báo cáo PDF.", "microphonePermission": false }]
    ]
  }
}
