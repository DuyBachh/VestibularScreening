{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "es2022",
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*.js", "src/**/*.jsx", "App.js"],
  "exclude": ["node_modules", ".expo", "dist"]
}
